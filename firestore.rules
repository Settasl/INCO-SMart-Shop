rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerOf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'settaholdings@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isBusinessMember(businessId) {
      return isSignedIn() && exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid));
    }

    function getBusinessMember(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)).data;
    }

    function hasBusinessRole(businessId, allowedRoles) {
      return isBusinessMember(businessId) && getBusinessMember(businessId).role in allowedRoles;
    }

    function isBusinessOwner(businessId) {
      return hasBusinessRole(businessId, ['owner']);
    }

    function isBusinessManager(businessId) {
      return hasBusinessRole(businessId, ['owner', 'manager']);
    }

    function isBusinessStaff(businessId) {
      return hasBusinessRole(businessId, ['owner', 'manager', 'cashier', 'inventory_manager', 'accountant', 'staff']);
    }

    // --- USER PROFILES ---
    match /users/{userId} {
      allow read: if isOwnerOf(userId) || isAdmin();
      allow create: if isOwnerOf(userId) && isValidId(userId)
                    && request.resource.data.uid == request.auth.uid
                    && (!('isVerified' in request.resource.data) || request.resource.data.isVerified == request.auth.token.email_verified)
                    && (!('role' in request.resource.data) || request.resource.data.role != 'admin' || isAdmin());
      allow update: if (isOwnerOf(userId) || isAdmin())
                    && request.resource.data.uid == resource.data.uid
                    && (!('isVerified' in request.resource.data) || isAdmin() || request.resource.data.isVerified == request.auth.token.email_verified)
                    && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role || isAdmin());
      allow delete: if isAdmin();
    }

    match /referralInvites/{inviteId} {
      allow create: if isSignedIn()
        && request.resource.data.inviterUid == request.auth.uid
        && request.resource.data.channel in ['whatsapp', 'copy']
        && request.resource.data.referralCode is string
        && request.resource.data.referralCode.size() >= 6
        && request.resource.data.referralCode.size() <= 64;
      allow read: if isAdmin() || (isSignedIn() && resource.data.inviterUid == request.auth.uid);
      allow update, delete: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.targetUid is string;
      allow update, delete: if false;
    }

    // --- PLATFORM SUPER ADMINS ---
    match /admins/{adminUid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- CONNECTION TEST ---
    match /test/connection {
      allow read: if true;
    }

    // --- TENANT BUSINESSES & SUBCOLLECTIONS ---
    match /businesses/{businessId} {
      // Business owner, verified members, or platform admin can read the business doc
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        isBusinessMember(businessId) ||
        isAdmin()
      );
      
      // Creating a new business: user must set themselves as owner
      allow create: if isSignedIn() && isValidId(businessId)
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.businessId == businessId;
      
      // Update business profile: owner or platform admin only
      allow update: if (isBusinessOwner(businessId) || isAdmin())
                    && request.resource.data.ownerId == resource.data.ownerId;
      
      // Delete business: owner or platform admin only
      allow delete: if isBusinessOwner(businessId) || isAdmin();

      // --- MEMBERSHIP & ROLES (RBAC) ---
      match /members/{memberUid} {
        // Members can read their own membership, verified business members, or admin
        allow read: if isSignedIn() && (
          isOwnerOf(memberUid) ||
          isBusinessMember(businessId) ||
          isAdmin()
        );
        
        // Onboarding: owner can create their own member record if they own the business doc
        // Or existing owner/manager can add other members
        allow create: if isSignedIn() && isValidId(memberUid) && (
          isAdmin() ||
          isBusinessOwner(businessId) ||
          (isBusinessManager(businessId) && !(request.resource.data.role in ['owner', 'super_admin'])) ||
          (
            isOwnerOf(memberUid) &&
            request.resource.data.role == 'owner' &&
            get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
          )
        );
        
        // Members cannot elevate their own role
        allow update: if isAdmin() || (
          isBusinessOwner(businessId) &&
          request.resource.data.role != 'super_admin'
        );
        
        // Owners can remove members (except self-removal if sole owner)
        allow delete: if isAdmin() || (
          isBusinessOwner(businessId) && memberUid != request.auth.uid
        );
      }

      // --- MASTER PRODUCT CATALOG ---
      match /products/{productId} {
        allow read: if isBusinessMember(businessId);
        allow create, update: if isBusinessManager(businessId) || hasBusinessRole(businessId, ['inventory_manager']);
        allow delete: if isBusinessOwner(businessId);
      }

      // --- INVENTORY STOCK ITEMS ---
      match /inventory/{inventoryId} {
        allow read: if isBusinessMember(businessId);
        allow create, update: if isBusinessStaff(businessId);
        allow delete: if isBusinessManager(businessId);
      }

      // --- STOCK MOVEMENT LEDGER (AUDITABLE) ---
      match /stockMovements/{movementId} {
        allow read: if isBusinessMember(businessId);
        allow create: if isBusinessStaff(businessId)
                      && request.resource.data.actorUid == request.auth.uid;
        // Ledger records are strictly immutable
        allow update, delete: if false;
      }

      // --- SALES TRANSACTIONS ---
      match /sales/{saleId} {
        allow read: if isBusinessMember(businessId);
        allow create: if isBusinessStaff(businessId);
        // Completed sales records are immutable by default
        allow update, delete: if isBusinessManager(businessId);
      }

      // --- ORDERS ---
      match /orders/{orderId} {
        allow read: if isBusinessMember(businessId);
        allow create, update: if isBusinessStaff(businessId);
        allow delete: if isBusinessManager(businessId);
      }

      // --- CUSTOMERS & CREDIT BOOK ---
      match /customers/{customerId} {
        allow read: if isBusinessMember(businessId);
        allow create, update: if isBusinessStaff(businessId);
        allow delete: if isBusinessManager(businessId);
      }

      // --- CREDIT ACCOUNTS & TRANSACTIONS ---
      match /creditAccounts/{creditId} {
        allow read: if isBusinessMember(businessId);
        allow create, update: if isBusinessStaff(businessId);
        allow delete: if isBusinessManager(businessId);
      }
      match /creditTransactions/{transactionId} {
        allow read: if isBusinessMember(businessId);
        allow create: if isBusinessStaff(businessId);
        allow update, delete: if false;
      }

      // --- EXPENSES ---
      match /expenses/{expenseId} {
        allow read: if isBusinessMember(businessId);
        allow create, update: if isBusinessStaff(businessId);
        allow delete: if isBusinessManager(businessId);
      }

      // --- SUPPLIERS ---
      match /suppliers/{supplierId} {
        allow read: if isBusinessMember(businessId);
        allow create, update: if isBusinessStaff(businessId);
        allow delete: if isBusinessManager(businessId);
      }

      // --- PAYMENTS & CASH TRANSACTIONS ---
      match /payments/{paymentId} {
        allow read: if isBusinessMember(businessId);
        allow create: if isBusinessStaff(businessId);
        allow update, delete: if isBusinessManager(businessId);
      }
      match /cashTransactions/{transactionId} {
        allow read: if isBusinessMember(businessId);
        allow create: if isBusinessStaff(businessId);
        allow update, delete: if isBusinessManager(businessId);
      }

      // --- NOTIFICATIONS ---
      match /notifications/{notificationId} {
        allow read: if isBusinessMember(businessId);
        allow create, update, delete: if isBusinessStaff(businessId);
      }

      // --- SETTINGS ---
      match /settings/{settingId} {
        allow read: if isBusinessMember(businessId);
        allow write: if isBusinessManager(businessId);
      }

      // --- REPORTS ---
      match /reports/{reportId} {
        allow read: if isBusinessMember(businessId);
        allow write: if isBusinessManager(businessId);
      }

      // --- IMMUTABLE AUDIT LOGS ---
      match /auditLogs/{logId} {
        allow read: if isBusinessManager(businessId) || isAdmin();
        allow create: if isBusinessMember(businessId)
                      && request.resource.data.actorUid == request.auth.uid;
        // Audit logs can NEVER be updated or deleted by anyone
        allow update, delete: if false;
      }
    }
  }
}
